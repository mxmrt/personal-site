    "preview": "node tools/preview.mjs",
    "serve": "node tools/serve.mjs public 8788",
    "images": "node tools/make-images.mjs"
  },
  "devDependencies": {
    "@fontsource/big-shoulders-display": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/martian-mono": "^5.3.0",
    "playwright": "^1.56.0",
    "pngjs": "^7.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}
