{
  "name": "maxmartinelli-site",
  "version": "2.1.0",
  "private": true,
  "description": "maxmartinelli.com: one page whose hero is Many Worlds, a WebGL ride through eight worlds in one 48 s loop. Static files for Cloudflare.",
  "scripts": {
    "build": "python3 build.py",
    "check": "python3 tools/check.py",
